{
  "name": "nextoffice",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "overrides": {
    "express": "$express",
    "@nestjs/common": "11.1.29",
    "@nestjs/core": "11.1.29"
  }
}
