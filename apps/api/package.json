{
  "name": "@nextoffice/api",
  "version": "0.0.1",
  "description": "AI E-office API",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "seed:admin": "node -r dotenv/config dist/prisma/seed-admin.js",
    "seed:sarabun": "node -r dotenv/config dist/prisma/seed-sarabun.js",
    "seed:school": "npx ts-node prisma/seed-school.ts",
    "seed:all": "npm run seed:admin && npm run seed:sarabun && npm run seed:school",
    "backfill:response-type": "npx ts-node -r dotenv/config prisma/backfill-response-classification.ts",
    "reindex:documents": "npx ts-node -r dotenv/config prisma/reindex-documents.ts",
    "reindex:documents:prod": "node -r dotenv/config dist/prisma/reindex-documents.js",
    "search:index": "node prisma/apply-search-index.js",
    "eval:retrieval": "npx ts-node -r dotenv/config prisma/eval-retrieval.ts",
    "eval:retrieval:prod": "node -r dotenv/config dist/prisma/eval-retrieval.js"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.module.ts",
      "!**/main.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@shared/(.*)$": "<rootDir>/../../packages/shared-types/src/$1"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@napi-rs/canvas": "^0.1.97",
    "@nestjs/bull": "11.0.5",
    "@nestjs/common": "11.1.29",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.29",
    "@nestjs/mapped-types": "2.1.1",
    "@nestjs/platform-express": "11.1.29",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.6",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@qdrant/js-client-rest": "^1.19.0",
    "@types/pdf-parse": "^1.1.5",
    "axios": "^1.19.0",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "crypto": "^1.0.1",
    "docx": "^9.7.1",
    "dotenv": "^16.4.5",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.1",
    "mariadb": "^3.5.3",
    "minio": "^8.0.7",
    "multer": "^2.2.0",
    "mysql2": "^3.23.3",
    "node-forge": "^1.4.0",
    "nodemailer": "^9.0.5",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "wordcut": "^0.9.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.29",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.43",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
